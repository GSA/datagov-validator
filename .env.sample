# host port docker compose publishes the API on. 8081 so it can run next to
# datagov-harvester (8080).
PORT=8081

# Private/internal fetch targets are refused unless this is true. Local
# development only - never set it on cloud.gov.
ALLOW_PRIVATE_ADDRESSES=true

# New Relic (non-sensitive). license key is pulled in .profile
NEW_RELIC_LICENSE_KEY=
NEW_RELIC_APP_NAME=
NEW_RELIC_MONITOR_MODE=false
NEW_RELIC_LOG=/var/log/new_relic.log
NEW_RELIC_LOG_LEVEL=info
NEW_RELIC_HOST=gov-collector.newrelic.com
